# Cabeçalhos HTTP do Cloudflare Pages (gerado no build como dist/_headers — não edite o dist).
# O marcador SCRIPT_HASHES (entre chaves duplas) recebe o SHA-256 de cada <script> inline do index.html (vite.config.ts).
# A página não carrega nada de terceiros: fonte, imagens e scripts são servidos pelo próprio domínio. O WhatsApp é aberto
# por link (navegação), que a CSP não restringe. Sem upgrade-insecure-requests: todos os recursos são relativos ao
# próprio domínio e o HSTS já força HTTPS; a diretiva só atrapalhava a validação local no WebKit (que a aplica até em
# http://127.0.0.1).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' {{SCRIPT_HASHES}}; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

# Arquivos com hash no nome: nunca mudam — cache longo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Documento e arquivos sem hash: sempre revalidados, para uma publicação nova aparecer na hora.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/release.json
  Cache-Control: no-cache
  X-Robots-Tag: noindex
