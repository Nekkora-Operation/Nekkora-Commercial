{
  "name": "nekkora-commercial",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Nekkora Commercial — página comercial do Nekkora Delivery e do Nekkora Hosting.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/testes/precos.test.mjs scripts/testes/verificar-publicacao.test.mjs scripts/testes/aws-publicacao.test.mjs scripts/testes/aws-auditoria.test.mjs scripts/testes/cloudfront-local.test.mjs scripts/testes/api-solicitacoes.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run verificar:precos && npm run aws:config:verificar",
    "homologacao": "node scripts/homologacao.mjs",
    "homologacao:canais": "node scripts/homologacao-canais.mjs",
    "verificar:publicacao": "node scripts/verificar-publicacao.mjs",
    "verificar:lib": "node scripts/verificar-lib.mjs",
    "texto": "node scripts/exportar-texto.mjs",
    "cloudfront:local": "node scripts/servidor-cloudfront-local.mjs --dist dist --porta 4173",
    "aws:config": "node scripts/aws/gerar-config.mjs",
    "aws:config:verificar": "node scripts/aws/gerar-config.mjs --verificar",
    "aws:auditar": "node scripts/aws/auditar.mjs",
    "api:local": "node scripts/api-local.mjs --porta 4178 --origem http://127.0.0.1:4177",
    "verificar:precos": "node scripts/verificar-precos-artefato.mjs --dist dist"
  },
  "dependencies": {
    "nekkora-lib": "file:vendor/nekkora-lib-0.2.0.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-acm": "3.1147.0",
    "@aws-sdk/client-cloudfront": "3.1147.0",
    "@aws-sdk/client-dynamodb": "3.1147.0",
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/client-sesv2": "3.1147.0",
    "@aws-sdk/client-ssm": "3.1147.0",
    "@aws-sdk/client-sts": "3.1147.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "4.13.0",
    "playwright": "1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
